{
  "name": "dsh-lifi-adapters",
  "version": "0.1.0",
  "type": "module",
  "description": "Glass-surface contract and third-party page adapters for Liue (dsh-lifiwallpaper). Adapter 0.1.0 requires Liue 0.2.7.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "lifi",
    "glassmorphism",
    "theme"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiueCreater/dsh-lifi-adapters.git"
  },
  "homepage": "https://github.com/LiueCreater/dsh-lifi-adapters#readme",
  "bugs": {
    "url": "https://github.com/LiueCreater/dsh-lifi-adapters/issues"
  }
}
